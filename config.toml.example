# rust-rtsp-viewer — exemplo de configuração
# Copie para config.toml e ajuste conforme necessário.
#
# Toda a configuração vem deste arquivo. Não há flags de CLI nem variáveis de
# ambiente: o único argumento aceito é o caminho do próprio arquivo
# (`rust-rtsp-viewer /caminho/config.toml`, default `./config.toml`).

# ── Padrões globais das câmeras ───────────────────────────────────────────
# Cada chave abaixo é um default: qualquer câmera em [[cameras]] pode
# sobrescrevê-la individualmente.

# Latência de rede em milissegundos (propriedade `latency` do rtspsrc).
# É o ÚNICO parâmetro de buffering do stream — todo o resto (queue2 do
# uridecodebin, jitterbuffer, filas internas) é gerenciado pelo GStreamer.
# Default: 100
# latency_ms = 100

# Elemento decoder GStreamer (ex.: decodebin, decodebin3, avdec_h264).
# Cadeias com espaços são permitidas (ex.: "rtph264depay ! h264parse ! avdec_h264").
# Ignorado quando use_uridecodebin = true.
# Default: "decodebin"
# decoder = "decodebin"

# Solicitar retransmissão de pacotes perdidos ao servidor RTSP.
# Melhora a qualidade em redes instáveis, mas algumas câmeras rejeitam.
# Default: true
# do_retransmission = true

# Tema da interface: "cosmic" (default — visual nativo COSMIC/Wayland:
# grafite, cantos arredondados, hairlines, sombras), "opencode", "dark",
# "light" ou "amoled".
# theme = "cosmic"

# ── Snapshot (tecla s / F12) ──────────────────────────────────────────────
# [snapshot]
# dir = "~/Pictures/rust-rtsp-viewer"   # diretório de saída
# quality = 92                          # 1–100; controla o esforço de
#                                       # compressão PNG (PNG é sem perdas):
#                                       # <50 rápido, 50–89 padrão, >=90 máximo
# burst_count = 1                       # frames por disparo (1 = simples,
#                                       # máx 50; intervalo fixo de 100 ms)

# ── Gravação (tecla r) ────────────────────────────────────────────────────
# A gravação usa splitmuxsink: os segmentos giram automaticamente ao atingir
# o limite de duração ou de tamanho, o que vier primeiro, e cada arquivo é
# finalizado corretamente ao parar.
# [recording]
# dir = "~/Videos/rust-rtsp-viewer"     # diretório de saída
# max_segment_duration_secs = 600       # duração máxima por segmento (10–86400)
# max_segment_size_bytes = 1073741824   # tamanho máximo (1 MiB – 16 GiB)
# container = "mkv"                     # "mkv" (padrão) ou "mp4"
#                                       # mkv sobrevive a queda de energia; mp4 não
# on_motion = false                     # grava sozinho enquanto há movimento
# motion_post_roll_secs = 15            # segue gravando N s após o último movimento (3–3600)
#                                       # as zonas de movimento se desenham pelo menu da câmera

# ── Notificações de desktop (movimento e câmera offline) ─────────────────
# Usa o comando `notify-send` (libnotify).
# [notifications]
# enabled = false
# cooldown_secs = 60    # intervalo mínimo entre avisos do mesmo tipo por câmera (>= 5)

# ── Detecção de movimento ────────────────────────────────────────────────
# Compara quadros a ~2 Hz por câmera ao vivo e registra "Movimento" na timeline
# na borda de subida. Desenhe zonas pelo menu da câmera (clique direito →
# "Zonas de movimento"): com zonas ativas, só o que muda dentro delas conta e
# `contour_area` passa a ser a fração da *zona*, não do quadro.
# [motion]
# enabled = true        # false desliga a detecção (e o gatilho on_motion/avisos)
# threshold = 25        # diferença de luma por pixel que conta como mudança (1–255)
# contour_area = 0.005  # fração de pixels mudados para declarar movimento (0.0–1.0)
# sample_stride = 8     # amostra 1 pixel a cada N em cada eixo (1–32; maior = mais leve)
# lightning_threshold = 0.8  # se esta fração do quadro muda de uma vez (troca IR/cor ao
#                       # anoitecer, exposição, PTZ) o quadro é descartado, não vira movimento
#                       # (0.0 desliga). Mede o quadro todo, mesmo com zonas.

# ── Áudio (tecla m alterna mute) ──────────────────────────────────────────
# O áudio roda em uma pipeline separada, por câmera, iniciada sob demanda.
# [audio]
# enabled = true   # false desabilita completamente o áudio na interface
# volume = 0.8     # volume padrão (0.0–1.0) quando a câmera não define o seu

# ── Modo de visualização ──────────────────────────────────────────────────
# Valores INICIAIS. Os ajustes feitos na interface (menu de densidade,
# paginação, carrossel, ordem das câmeras) são salvos em
# ~/.local/state/rust-rtsp-viewer/view.toml e têm prioridade na próxima
# execução — apague esse arquivo para voltar aos valores abaixo.
# [view]
# mode = "auto"           # "auto" (todas numa página, células equilibradas)
#                         # ou uma grade fixa: "2x2", "3x3", "4x4" — a grade
#                         # fixa é o que liga a paginação (setas ‹ ›, [ ],
#                         # PageUp/PageDown).
# rotate_enabled = false  # iniciar com o carrossel de páginas ligado (tecla c)
# rotate_secs = 10        # tempo em cada página, em segundos (3–300; +/- na toolbar)
# pause_hidden = true     # só decodifica as câmeras da página visível (+ a
#                         # próxima como prefetch); pausa o resto. false mantém
#                         # todas as pipelines ativas (troca de página instantânea,
#                         # mais CPU/rede). Câmera pausada não detecta movimento:
#                         # com [recording] on_motion ou [notifications] ligados
#                         # (e [motion] enabled), todas as câmeras continuam
#                         # decodificando mesmo fora da página — use sub_url para
#                         # que isso custe pouco.
# stagger_ms = 200        # intervalo entre o início de cada pipeline no arranque
#                         # e nas trocas de página (evita congelar abrindo uma
#                         # dúzia de streams de uma vez). 0 = o mais rápido possível.
# layout = "grid"         # "grid" ou "flex" (uma grande + tira de miniaturas)

# ── Câmeras ───────────────────────────────────────────────────────────────
# Pelo menos uma [[cameras]] é obrigatória. Todas são abertas em grade.

[[cameras]]
url = "rtsp://admin:senha@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0"
name = "frente"           # alias curto (opcional)
label = "Garagem"         # nome exibido na sidebar (opcional)
audio_volume = 0.8        # volume desta câmera (0.0–1.0); ausente = usa [audio].volume
# latency_ms = 100        # override da latência global (opcional)
# decoder = "decodebin"   # override do decoder global (opcional)
# sub_url = "rtsp://admin:senha@192.168.1.100:554/cam/realmonitor?channel=1&subtype=1"
#                         # stream de baixa resolução usado nos blocos da grade; o
#                         # principal (url) é usado no spotlight, no destaque do Flex
#                         # e durante a gravação. Reduz bastante o custo com muitas câmeras.
# use_uridecodebin = false # força uridecodebin; auto-detectado por http:// e https://
# do_retransmission = true # override do retransmission global (opcional)

[[cameras]]
url = "https://exemplo.com/stream.m3u8"
name = "riojardim"
label = "Rio Jardim Sofia"
# HLS/HTTP já ativa uridecodebin3 automaticamente pelo esquema da URL.

# ── Grupos de câmeras (opcional) ──────────────────────────────────────────
# Cada [[groups]] vira um chip de filtro na sidebar; ao selecioná-lo, a lista
# e a grade mostram só as câmeras do grupo. `cameras` são índices 0-based em
# [[cameras]] (a primeira câmera é 0). Um índice inválido ou grupos que se
# sobrepõem fazem o conjunto inteiro ser ignorado (com aviso no log).
# [[groups]]
# name = "Rua"
# cameras = [0, 1]
# [[groups]]
# name = "Fundos"
# cameras = [2]

# ── Aviso com a janela fechada (rrv-daemon) ──────────────────────────────
# O daemon envia um POST a esta URL quando acontece um evento que merece aviso
# (movimento, câmera offline), com o mesmo cooldown de `[notifications]`.
# Funciona com Home Assistant (webhook), ntfy, n8n, Node-RED... Usa o `curl`.
# A URL costuma levar o token: ela nunca é escrita no log (só esquema://host).
# [webhook]
# url = "https://ntfy.sh/meu-topico-secreto"
# format = "json"       # "json" (padrão: camera, event, detail, title, message, time_unix) ou "ntfy"
# timeout_secs = 5      # 1–60
