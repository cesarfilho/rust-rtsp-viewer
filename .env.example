# RTSP Viewer Configuration via Environment Variables
# 
# Copy this file to .env and set your desired features.
# Features enabled by default can be disabled with=false.
# Features disabled by default require explicit=true.
#
# Example usage:
# RTSP_FEATURE_AUDIO=false
# RTSP_FEATURE_RECORDING=false
# RTSP_FEATURE_FULLSCREEN=true
# RTSP_FEATURE_SNAPSHOT=true
# RTSP_FEATURE_PAUSE=true
# RTSP_FEATURE_NIGHT_DETECTION=true
# RTSP_FEATURE_TAMPER_DETECTION=true
# RTSP_HW_DECODE=false
# RTSP_GL_RENDER=false
# RTSP_ONVIF_PTZ=false
#
# -- Basic Features (always enabled) --
# Core RTSP playback and decoding
# RTSP_FEATURE_CORE=true
# Video rendering with GTK
# RTSP_FEATURE_VIDEO=true
# Network retransmission (improves quality)
# RTSP_FEATURE_RETRANSMISSION=true

# -- P2 Features (default enabled) --
# Audio playback and mute control
RTSP_FEATURE_AUDIO=true
# Video recording (MKV/MP4)
RTSP_FEATURE_RECORDING=true
# Fullscreen toggle (F11)
RTSP_FEATURE_FULLSCREEN=true
# Snapshot capture (F12/s)
RTSP_FEATURE_SNAPSHOT=true
# Pause/resume (Space/k)
RTSP_FEATURE_PAUSE=true

# -- P2 Analytics Features (default enabled) --
# Automatic night detection
RTSP_FEATURE_NIGHT_DETECTION=true
# Tamper detection
RTSP_FEATURE_TAMPER_DETECTION=true

# -- P3 Features (default disabled) --
# Hardware acceleration (H264/H265 decode)
RTSP_HW_DECODE=false
# OpenGL rendering (performance)
RTSP_GL_RENDER=false
# ONVIF protocol support
RTSP_ONVIF_PTZ=false

# -- UI/UX --
# Enable all tooltips and notifications
RTSP_FEATURE_NOTIFICATIONS=true
# Enable compact overlay mode
RTSP_FEATURE_COMPACT_OVERLAY=false
# Enable debug logging
RTSP_DEBUG_LOGS=false

# Decodificador a ser usado (exemplo para H.264)
RTSP_DECODER=avdec_h264
