# Configuração do rrv-daemon em Docker. Copie para `config.docker.toml` (esse nome
# está no .gitignore) e ajuste. As câmeras e demais chaves são as mesmas do
# `config.toml.example`; só os caminhos mudam: dentro do contêiner, as gravações
# vão para /data e o estado (logs, zonas) para /state.

[recording]
dir = "/data"
on_motion = true
motion_post_roll_secs = 15

[logs]
dir = "/state/logs"

[motion]
enabled = true

# Detecção de objetos: só com compose.detect.yaml (CPU) ou compose.detect-cuda.yaml (GPU NVIDIA);
# o modelo vem de `scripts/fetch-model.sh`, montado em /models.
# [detect]
# enabled = true
# model = "/models/yolo11n-640.onnx"
# backend = "auto"            # "cpu", "cuda" ou "auto"
# labels = ["person", "car"]
# cameras = ["Portão"]        # só estas câmeras vão ao modelo (vazio = todas)
# record = true               # grava só enquanto uma dessas classes aparece (com [recording] on_motion = false)
# snapshot = true             # JPEG com as caixas em recordings/snapshots/<câmera>/<dia>/

# A janela em outra máquina (ou neste desktop, pelo IP): TCP com token. O tráfego NÃO é criptografado
# (só numa LAN de confiança). Crie o token: `openssl rand -hex 24 > secrets/rrv_token && chmod 600 secrets/rrv_token`.
# A porta + 1 (7879) serve os vídeos gravados para o player da janela.
# [daemon]
# listen = "0.0.0.0:7878"
# token  = "${rrv_token}"

# A senha NÃO fica aqui: `${cam_portao_password}` é um segredo do Docker (veja o compose.yaml e o
# README). O valor vem de /run/secrets/cam_portao_password, ou de uma variável de ambiente de mesmo nome.
[[cameras]]
name = "Portão"
url = "rtsp://usuario:${cam_portao_password}@192.168.0.10:554/stream1"
# sub_url = "rtsp://usuario:${cam_portao_password}@192.168.0.10:554/stream2"

# ── Aviso com a janela fechada (rrv-daemon) ──────────────────────────────
# O daemon envia um POST a esta URL quando acontece um evento que merece aviso
# (movimento, câmera offline), com o mesmo cooldown de `[notifications]`.
# Funciona com Home Assistant (webhook), ntfy, n8n, Node-RED... Usa o `curl`.
# A URL costuma levar o token: ela nunca é escrita no log (só esquema://host).
# [webhook]
# url = "https://ntfy.sh/meu-topico-secreto"
# format = "json"       # "json" (padrão: camera, event, detail, title, message, time_unix) ou "ntfy"
# timeout_secs = 5      # 1–60
